{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": ".test-out",
    "rootDir": "src/lib",
    "rewriteRelativeImportExtensions": true,
    "incremental": false,
    "types": ["node"],
    "plugins": []
  },
  "include": ["src/lib/**/*.ts"],
  "exclude": []
}
